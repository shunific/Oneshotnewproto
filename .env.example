VITE_SUPABASE_URL=https://olywhyaozjlkjrnsdydg.supabase.co
VITE_SUPABASE_SERVICE_KEY=your_supabase_service_role_key
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key
SUPABASE_URL=https://olywhyaozjlkjrnsdydg.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SQLITE_DB_PATH=oneshot-tester1.db
PORT=3001

# ── Customer email notifications (optional) ──
# Pick ONE transport. Leave everything blank to disable emails safely.
# Option A: Resend (https://resend.com) — single API key, works from server + Supabase.
RESEND_API_KEY=
EMAIL_FROM=notifications@yourdomain.com
EMAIL_FROM_NAME=One Shot Bar & Billiards
# Option B: SMTP (requires `npm install nodemailer`)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Set to false to switch notifications off without removing credentials.
EMAIL_NOTIFICATIONS_ENABLED=true
